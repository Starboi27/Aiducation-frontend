# ── 브라우저 설정 ───────────────────────────────────────────────
BROWSER=/mnt/c/Program Files/Google/Chrome/Application/chrome.exe

# ── 개발 환경 ──────────────────────────────────────────────────
# package.json의 "proxy": "http://localhost:8080" 이 /api/* 요청을 중계함
# → REACT_APP_API_URL 주석 처리 시 apiClient가 상대 경로 사용 (CORS 없음)
# REACT_APP_API_URL=http://localhost:8080

# ── 프로덕션 배포 시 ────────────────────────────────────────────
# REACT_APP_API_URL=https://api.yourdomain.com

# 카카오 OAuth 클라이언트 ID (Spring Boot가 OAuth 엔드포인트로 사용)
REACT_APP_KAKAO_CLIENT_ID=098ad96e323113bb49472055012019f8
